# EditorConfig: the whitespace rules of STYLE.md.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,h,sh,awk,spec}]
indent_style = tab
tab_width = 8
indent_size = tab
max_line_length = 80

[Makefile]
indent_style = tab
tab_width = 8
indent_size = tab

[*.md]
indent_style = space
indent_size = 4
max_line_length = 80
