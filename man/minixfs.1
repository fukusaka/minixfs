.Dt MINIXFS 1
.Os
.Sh NAME
.Nm minixfs
.Nd inspect and extract MINIX file system images
.Sh SYNOPSIS
.Nm
.Op Fl M Ar size : Ns Ar heads : Ns Ar side
.Cm info
.Ar image
.Nm
.Op Fl M Ar size : Ns Ar heads : Ns Ar side
.Cm ls
.Op Fl lR
.Ar image
.Op Ar path
.Nm
.Op Fl M Ar size : Ns Ar heads : Ns Ar side
.Cm cat
.Ar image
.Ar path
.Nm
.Op Fl M Ar size : Ns Ar heads : Ns Ar side
.Cm blocks
.Op Fl r
.Ar image
.Ar path
.Nm
.Op Fl M Ar size : Ns Ar heads : Ns Ar side
.Cm extract
.Op Fl dv
.Ar image
.Ar dest
.Op Ar path
.Nm
.Op Fl M Ar size : Ns Ar heads : Ns Ar side
.Cm tar
.Ar image
.Op Ar path
.Nm
.Op Fl M Ar size : Ns Ar heads : Ns Ar side
.Op Fl f
.Cm put
.Op Fl Rdin
.Op Fl o Ar uid : Ns Ar gid
.Ar image
.Ar host ...
.Ar path
.Nm
.Op Fl M Ar size : Ns Ar heads : Ns Ar side
.Op Fl f
.Cm mkdir
.Op Fl p
.Op Fl m Ar mode
.Op Fl o Ar uid : Ns Ar gid
.Ar image
.Ar path ...
.Nm
.Op Fl M Ar size : Ns Ar heads : Ns Ar side
.Op Fl f
.Cm rm
.Op Fl r
.Ar image
.Ar path ...
.Nm
.Op Fl M Ar size : Ns Ar heads : Ns Ar side
.Op Fl f
